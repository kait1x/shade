# Shade Messenger Server Configuration
# SECURITY: Change these values in production!

# Dashboard password (REQUIRED - server won't start without it)
# Generate a strong password and set it here, or use environment variable DASHBOARD_PASS
DASHBOARD_PASS=<SET_YOUR_STRONG_PASSWORD_HERE>

# Environment mode (production or development)
NODE_ENV=development

# Allowed CORS origins (comma-separated list)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080

# Ports
HTTP_PORT=3000
HTTPS_PORT=3443

# Data directory
DATA_DIR=./data

# Certificate directory
CERT_DIR=./certs
