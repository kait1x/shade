# Separate alpha origin, OAuth client and storage. Never point at production.
# Copy to /etc/shade-alpha/alpha.env (root:shade-alpha 0640) and fill in.
# Generate secrets locally; never commit real values.
SHADE_ENV=alpha
ALPHA_PORT=3101
ALPHA_PUBLIC_ORIGIN=https://alpha.example.com
ALPHA_DATA_DIR=/var/lib/shade-alpha/data
# openssl rand -hex 32
ALPHA_STORAGE_SECRET=REPLACE_WITH_NEW_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
# Separate OAuth Web client for the alpha origin (see docs/IPHONE_PWA_STAGING.md).
ALPHA_GOOGLE_CLIENT_ID=REPLACE_WITH_ALPHA_WEB_CLIENT_ID.apps.googleusercontent.com
ALPHA_GOOGLE_CLIENT_SECRET=REPLACE_WITH_ALPHA_WEB_CLIENT_SECRET
# Web Push (wake-only). Generate: npx web-push generate-vapid-keys
# The PUBLIC key is served to clients via /api/session; the PRIVATE key stays here.
ALPHA_VAPID_PUBLIC_KEY=REPLACE_WITH_VAPID_PUBLIC_KEY
ALPHA_VAPID_PRIVATE_KEY=REPLACE_WITH_VAPID_PRIVATE_KEY
ALPHA_VAPID_SUBJECT=mailto:admin@example.com
# Optional SSRF hardening: comma-separated allowed push endpoint hosts.
# Empty/unset = built-in public-endpoint guard only.
ALPHA_PUSH_ALLOWED_HOSTS=fcm.googleapis.com,updates.push.services.mozilla.com,push.services.mozilla.com,web.push.apple.com
