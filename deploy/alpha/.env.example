# Separate alpha origin, OAuth client and storage. Never point at production.
# Copy to /etc/shade-alpha/alpha.env (root:shade-alpha 0640) and fill in.
# Generate secrets locally; never commit real values.
SHADE_ENV=alpha
ALPHA_PORT=3101
ALPHA_PUBLIC_ORIGIN=https://alpha.example.com
ALPHA_DATA_DIR=/var/lib/shade-alpha/data
# openssl rand -hex 32
ALPHA_STORAGE_SECRET=REPLACE_WITH_NEW_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
# Separate OAuth Web client for the alpha origin (see docs/IPHONE_PWA_STAGING.md).
ALPHA_GOOGLE_CLIENT_ID=REPLACE_WITH_ALPHA_WEB_CLIENT_ID.apps.googleusercontent.com
ALPHA_GOOGLE_CLIENT_SECRET=REPLACE_WITH_ALPHA_WEB_CLIENT_SECRET
# Web Push (wake-only). Generate: npx web-push generate-vapid-keys
# The PUBLIC key is served to clients via /api/session; the PRIVATE key stays here.
ALPHA_VAPID_PUBLIC_KEY=REPLACE_WITH_VAPID_PUBLIC_KEY
ALPHA_VAPID_PRIVATE_KEY=REPLACE_WITH_VAPID_PRIVATE_KEY
ALPHA_VAPID_SUBJECT=mailto:admin@example.com
# Optional SSRF hardening: comma-separated allowed push endpoint hosts.
# Empty/unset = built-in public-endpoint guard only.
ALPHA_PUSH_ALLOWED_HOSTS=fcm.googleapis.com,updates.push.services.mozilla.com,push.services.mozilla.com,web.push.apple.com
# Optional READ-ONLY v1 migration bridge (staging copy of the v1 data dir;
# production only with owner approval). The alpha process never writes into
# this directory. Accounts must be prepared first with tools/migrate-v1-to-v2.mjs.
# ALPHA_V1_DATA_DIR=/var/lib/shade-alpha/v1-copy
# ALPHA_V1_SECRET_ENV=V1_SESSION_SECRET   # env var holding the v1 secret;
#                                         # default: read <dir>/session_secret
# Guard file consumed by the v1 server (SHADE_V2_GUARD_FILE on shade.service).
# Additive export owned by this process; enrolled accounts get upgrade_required
# on v1 auth/send routes (incoming v1 messages TO them are bridged, not blocked).
# Point at the v1 DATA_DIR only with owner approval.
# ALPHA_V2_GUARD_FILE=/var/lib/shade-alpha/v2-migration-guard.json
# Bridge-ack export: ACK tombstones for the live v1→v2 bridge. The v1 server
# reads it via SHADE_V2_BRIDGE_ACK_FILE, prunes confirmed ciphertext from its
# queue and advances receipts to delivered. Same directory/permissions as guard.
# ALPHA_V2_BRIDGE_ACK_FILE=/var/lib/shade-alpha/v2-bridge-ack.json
# Durable rolling checkpoints of every saved v2 snapshot (lossless rollback,
# docs/V2_ROLLBACK.md §2). Keep N most recent; best-effort, never breaks saves.
# ALPHA_CHECKPOINT_DIR=/var/lib/shade-alpha/checkpoints
# ALPHA_CHECKPOINT_KEEP=20
