# Separate alpha origin, OAuth client and storage. Never point at production.
SHADE_ENV=alpha
ALPHA_PORT=3101
ALPHA_PUBLIC_ORIGIN=https://alpha.example.com
ALPHA_DATA_DIR=/var/lib/shade-alpha/data
ALPHA_STORAGE_SECRET=REPLACE_WITH_NEW_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
ALPHA_GOOGLE_CLIENT_ID=REPLACE_WITH_ALPHA_WEB_CLIENT_ID.apps.googleusercontent.com
ALPHA_GOOGLE_CLIENT_SECRET=REPLACE_WITH_ALPHA_WEB_CLIENT_SECRET
