# Shade v2 PRODUCTION env — ШАБЛОН, НЕ ПРИМЕНЁН.
# Copy to /etc/shade-v2/v2.env (root:shade-v2 0640). Generate NEW secrets;
# never reuse staging/production-v1 secrets; never commit real values.
# alpha.mjs startup requires SHADE_ENV=alpha (process marker, not a target).
SHADE_ENV=alpha
ALPHA_PORT=3201
ALPHA_PUBLIC_ORIGIN=https://app.shadechat.ru
# Native Android talks to api.<domain> and sends that Origin; allow it as a
# first-party extra origin (OAuth redirect/cookies stay canonical on app).
ALPHA_ALLOWED_ORIGINS=https://api.shadechat.ru
ALPHA_DATA_DIR=/var/lib/shade-v2/data
# openssl rand -hex 32
ALPHA_STORAGE_SECRET=REPLACE_WITH_NEW_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
# Separate OAuth Web client for https://app.shadechat.ru (Google Console).
ALPHA_GOOGLE_CLIENT_ID=REPLACE_WITH_PRODUCTION_WEB_CLIENT_ID.apps.googleusercontent.com
ALPHA_GOOGLE_CLIENT_SECRET=REPLACE_WITH_PRODUCTION_WEB_CLIENT_SECRET
# Web Push (wake-only). npx web-push generate-vapid-keys
ALPHA_VAPID_PUBLIC_KEY=REPLACE_WITH_VAPID_PUBLIC_KEY
ALPHA_VAPID_PRIVATE_KEY=REPLACE_WITH_VAPID_PRIVATE_KEY
ALPHA_VAPID_SUBJECT=mailto:admin@shadechat.ru
ALPHA_PUSH_ALLOWED_HOSTS=fcm.googleapis.com,updates.push.services.mozilla.com,push.services.mozilla.com,web.push.apple.com
# READ-ONLY v1 bridge: production v1 data dir. Включать ТОЛЬКО на этапе D
# (canary) с отдельного разрешения владельца; до этого — staging-копия.
# ALPHA_V1_DATA_DIR=/var/lib/shade/data
# Guard + bridge-ack: additive exports, читаются v1-сервером (SHADE_V2_GUARD_FILE
# и SHADE_V2_BRIDGE_ACK_FILE в /etc/shade/shade.env). Включение guard в production
# v1 — отдельное разрешение владельца (этап D).
# ALPHA_V2_GUARD_FILE=/var/lib/shade-v2/v2-migration-guard.json
# ALPHA_V2_BRIDGE_ACK_FILE=/var/lib/shade-v2/v2-bridge-ack.json
# Durable rolling checkpoints (lossless rollback).
ALPHA_CHECKPOINT_DIR=/var/lib/shade-v2/checkpoints
ALPHA_CHECKPOINT_KEEP=20

# Android push via Firebase Admin application-default credentials.
ALPHA_FCM_ENABLED=false
