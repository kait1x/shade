# Shade v2 STAGING env — ШАБЛОН. Фактический путь задаёт systemd-юнит
# shade-staging.service: EnvironmentFile=/var/lib/shade-staging/staging.env
# (root:shade-staging 0600/0640). Generate NEW secrets ON THE SERVER; never
# reuse production secrets; never commit/print real values.
# alpha.mjs startup requires SHADE_ENV=alpha (process marker).
SHADE_ENV=alpha
ALPHA_PORT=3101
ALPHA_PUBLIC_ORIGIN=https://alpha.shadechat.ru
ALPHA_DATA_DIR=/var/lib/shade-staging/data
# openssl rand -hex 32
ALPHA_STORAGE_SECRET=REPLACE_WITH_NEW_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
# Separate OAuth Web client for https://alpha.shadechat.ru (Google Console;
# steps: docs/IPHONE_PWA_STAGING.md §3). Never reuse the production client.
ALPHA_GOOGLE_CLIENT_ID=REPLACE_WITH_STAGING_WEB_CLIENT_ID.apps.googleusercontent.com
ALPHA_GOOGLE_CLIENT_SECRET=REPLACE_WITH_STAGING_WEB_CLIENT_SECRET
# Web Push (wake-only). npx web-push generate-vapid-keys
ALPHA_VAPID_PUBLIC_KEY=REPLACE_WITH_VAPID_PUBLIC_KEY
ALPHA_VAPID_PRIVATE_KEY=REPLACE_WITH_VAPID_PRIVATE_KEY
ALPHA_VAPID_SUBJECT=mailto:admin@shadechat.ru
ALPHA_PUSH_ALLOWED_HOSTS=fcm.googleapis.com,updates.push.services.mozilla.com,push.services.mozilla.com,web.push.apple.com
# READ-ONLY v1 bridge: STAGING COPY of the v1 data dir (owner-created copy,
# docs/V2_DEPLOYMENT.md §3.1). The alpha process never writes into it.
# Without the copy, staging runs on synthetic fixtures only.
# ALPHA_V1_DATA_DIR=/var/lib/shade-staging/v1-copy
# Guard + bridge-ack for the STAGING v1 copy only (never production paths).
# ALPHA_V2_GUARD_FILE=/var/lib/shade-staging/v2-migration-guard.json
# ALPHA_V2_BRIDGE_ACK_FILE=/var/lib/shade-staging/v2-bridge-ack.json
# Durable rolling checkpoints (lossless rollback, docs/V2_ROLLBACK.md §2).
ALPHA_CHECKPOINT_DIR=/var/lib/shade-staging/checkpoints
ALPHA_CHECKPOINT_KEEP=20