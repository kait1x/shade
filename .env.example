# Copy to .env locally; never commit secrets. Production requires CA-signed certs.
DASHBOARD_PASS=replace-with-a-unique-password
SESSION_SECRET=replace-with-a-stable-random-secret
GOOGLE_WEB_CLIENT_ID=replace-with-web-client-id.apps.googleusercontent.com
ALLOWED_ORIGINS=https://your-domain.example
NODE_ENV=production
